{
  "manifest_version": 3,
  "name": "拾页 · PagePick",
  "version": "0.4.1",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "clipboardWrite",
    "debugger",
    "nativeMessaging",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture_state": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "冻结捕获当前交互状态（不滚动、不失焦，完美捕获展开菜单和弹窗）"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "拾页 · PagePick",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "hover-engine.js",
        "content.js"
      ]
    }
  ],
  "description": "一键捕获网页，将页面与交互状态收进 Figma。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}